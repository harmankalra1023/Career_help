# Digital Career Twin (DCT) - Environment Variables Template
# Copy this file to .env and insert your API keys.

# ==============================================================================
# LLM / AI Configuration (Groq Provider)
# ==============================================================================
# Provider options: groq | mock | ollama | openai_compat | anthropic
LLM_PROVIDER=groq

# Paste your Groq API key here (obtain from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq Models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

ALLOW_REMOTE_LLM=true

# ==============================================================================
# Database & Cache
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://dct:dct@localhost:5432/dct
DATABASE_URL_SYNC=postgresql://dct:dct@localhost:5432/dct
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Security & Authentication
# ==============================================================================
JWT_SECRET=supersecretdevkeynotforproduction1234567890abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
ENCRYPTION_KEY=dGhpc2lzYXRlc3RmZXJuZXRrZXkxMjM0NTY3ODkwYWI=

# ==============================================================================
# Embeddings & Taxonomy
# ==============================================================================
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DEVICE=cpu

# ==============================================================================
# Optional OAuth & External APIs
# ==============================================================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================================
# Storage
# ==============================================================================
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# ==============================================================================
# Market & Regional Settings
# ==============================================================================
DEFAULT_REGION=global
DEFAULT_CURRENCY=USD
MARKET_STALE_DAYS=45

# ==============================================================================
# Server & Logging
# ==============================================================================
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
